#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Windows script files should use crlf
*.bat           text eol=crlf

# Deno/Rust source is UTF-8 text; keep LF stable across checkouts
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.rs            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.svg           text eol=lf
*.webmanifest   text eol=lf

# Binary files should be left untouched
*.png           binary
*.wasm          binary

