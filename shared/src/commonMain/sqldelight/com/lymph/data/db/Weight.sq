CREATE TABLE weight_records (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    weightKg REAL NOT NULL,
    note TEXT
);

CREATE INDEX idx_weight_timestamp ON weight_records(timestamp);

selectAll:
SELECT * FROM weight_records ORDER BY timestamp DESC;

selectSnapshot:
SELECT * FROM weight_records ORDER BY timestamp DESC;

insertOrIgnore:
INSERT OR IGNORE INTO weight_records(id, timestamp, weightKg, note)
VALUES (?, ?, ?, ?);

deleteById:
DELETE FROM weight_records WHERE id = ?;
