CREATE TABLE period_records (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    durationDays INTEGER NOT NULL,
    flowIntensity INTEGER NOT NULL,
    symptoms TEXT
);

CREATE INDEX idx_period_timestamp ON period_records(timestamp);

selectAll:
SELECT * FROM period_records ORDER BY timestamp DESC;

selectSnapshot:
SELECT * FROM period_records ORDER BY timestamp DESC;

insertOrIgnore:
INSERT OR IGNORE INTO period_records(id, timestamp, durationDays, flowIntensity, symptoms)
VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM period_records WHERE id = ?;
