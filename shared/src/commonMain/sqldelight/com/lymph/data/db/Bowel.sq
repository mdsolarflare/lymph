CREATE TABLE bowel_records (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    bristolType INTEGER NOT NULL,
    effortLevel INTEGER NOT NULL,
    note TEXT
);

CREATE INDEX idx_bowel_timestamp ON bowel_records(timestamp);

selectAll:
SELECT * FROM bowel_records ORDER BY timestamp DESC;

selectSnapshot:
SELECT * FROM bowel_records ORDER BY timestamp DESC;

insertOrIgnore:
INSERT OR IGNORE INTO bowel_records(id, timestamp, bristolType, effortLevel, note)
VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM bowel_records WHERE id = ?;
